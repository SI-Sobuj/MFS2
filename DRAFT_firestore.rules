rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 4.1: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Pillar 2: Validation Blueprints (Anti-Update-Gap)
    function isValidUserWallet(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'accountNumber',
        'balance',
        'savingsBalance',
        'rewardPoints',
        'biometricEnabled',
        'pinHash',
        'kycTier',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'accountNumber',
        'balance',
        'savingsBalance',
        'rewardPoints',
        'biometricEnabled',
        'pinHash',
        'kycTier',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
      data.accountNumber is string && data.accountNumber.size() >= 11 && data.accountNumber.size() <= 15 &&
      data.balance is number && data.balance >= 0 && data.balance <= 10000000 &&
      data.savingsBalance is number && data.savingsBalance >= 0 && data.savingsBalance <= 10000000 &&
      data.rewardPoints is number && data.rewardPoints >= 0 && data.rewardPoints <= 1000000 &&
      data.biometricEnabled is bool &&
      data.pinHash is string && data.pinHash.size() >= 8 && data.pinHash.size() <= 128 &&
      data.kycTier is string && data.kycTier.size() <= 32 &&
      (data.kycTier == 'Verified Tier 1' || data.kycTier == 'Premier MFS') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidEncryptedTransaction(data) {
      return data.keys().hasAll([
        'uid',
        'txId',
        'type',
        'title',
        'counterpartyMasked',
        'amount',
        'fee',
        'cashback',
        'balanceAfter',
        'encryptedPayload',
        'iv',
        'cipherAlg',
        'authMethod',
        'status',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'txId',
        'type',
        'title',
        'counterpartyMasked',
        'amount',
        'fee',
        'cashback',
        'balanceAfter',
        'encryptedPayload',
        'iv',
        'cipherAlg',
        'authMethod',
        'status',
        'createdAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.txId is string && data.txId.size() >= 1 && data.txId.size() <= 64 && data.txId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.type is string && data.type.size() <= 32 &&
      (
        data.type == 'send_money' ||
        data.type == 'cash_in' ||
        data.type == 'cash_out' ||
        data.type == 'mobile_recharge' ||
        data.type == 'utility_bill' ||
        data.type == 'qr_payment' ||
        data.type == 'savings_deposit' ||
        data.type == 'savings_withdraw'
      ) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
      data.counterpartyMasked is string && data.counterpartyMasked.size() >= 1 && data.counterpartyMasked.size() <= 80 &&
      data.amount is number && data.amount > 0 && data.amount <= 500000 &&
      data.fee is number && data.fee >= 0 && data.fee <= 10000 &&
      data.cashback is number && data.cashback >= 0 && data.cashback <= 10000 &&
      data.balanceAfter is number && data.balanceAfter >= 0 && data.balanceAfter <= 10000000 &&
      data.encryptedPayload is string && data.encryptedPayload.size() >= 1 && data.encryptedPayload.size() <= 2048 &&
      data.iv is string && data.iv.size() >= 1 && data.iv.size() <= 128 &&
      data.cipherAlg is string && data.cipherAlg.size() <= 32 && data.cipherAlg == 'AES-256-GCM' &&
      data.authMethod is string && data.authMethod.size() <= 32 &&
      (data.authMethod == 'Biometric Passkey' || data.authMethod == 'PIN + Biometric') &&
      data.status is string && data.status.size() <= 20 && data.status == 'completed' &&
      data.createdAt is timestamp;
    }

    function isValidSavingsGoal(data) {
      return data.keys().hasAll([
        'uid',
        'goalId',
        'name',
        'schemeType',
        'targetAmount',
        'currentAmount',
        'monthlyInstallment',
        'profitRate',
        'maturityDate',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'goalId',
        'name',
        'schemeType',
        'targetAmount',
        'currentAmount',
        'monthlyInstallment',
        'profitRate',
        'maturityDate',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.goalId is string && data.goalId.size() >= 1 && data.goalId.size() <= 64 && data.goalId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
      data.schemeType is string && data.schemeType.size() <= 40 &&
      (
        data.schemeType == 'Islamic Mudarabah DPS' ||
        data.schemeType == 'Fixed Term Savings' ||
        data.schemeType == 'Micro Vault'
      ) &&
      data.targetAmount is number && data.targetAmount >= 500 && data.targetAmount <= 10000000 &&
      data.currentAmount is number && data.currentAmount >= 0 && data.currentAmount <= 10000000 &&
      data.monthlyInstallment is number && data.monthlyInstallment >= 100 && data.monthlyInstallment <= 500000 &&
      data.profitRate is number && data.profitRate >= 0 && data.profitRate <= 20 &&
      data.maturityDate is string && data.maturityDate.size() >= 1 && data.maturityDate.size() <= 32 &&
      data.status is string && data.status.size() <= 20 &&
      (data.status == 'active' || data.status == 'completed') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidNotificationItem(data) {
      return data.keys().hasAll([
        'uid',
        'notifId',
        'title',
        'body',
        'category',
        'read',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'notifId',
        'title',
        'body',
        'category',
        'read',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.notifId is string && data.notifId.size() >= 1 && data.notifId.size() <= 64 && data.notifId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
      data.body is string && data.body.size() >= 1 && data.body.size() <= 280 &&
      data.category is string && data.category.size() <= 24 &&
      (
        data.category == 'transaction' ||
        data.category == 'security' ||
        data.category == 'cashback' ||
        data.category == 'savings'
      ) &&
      data.read is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection 1: Root User Wallets (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserWallet(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserWallet(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().accountNumber == existing().accountNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Balance, Savings & Reward Mutation during MFS Transaction
          incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'savingsBalance', 'rewardPoints', 'updatedAt']) ||
          // Action 2: Security & Profile Settings Update
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'biometricEnabled', 'pinHash', 'kycTier', 'updatedAt'])
        );

      allow delete: if false;

      // Subcollection 1: Immutable Encrypted Transactions (/users/{userId}/transactions/{txId})
      match /transactions/{txId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(txId) &&
          existing().uid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isOwner(userId) &&
          existing().uid == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(txId) &&
          isValidEncryptedTransaction(incoming()) &&
          incoming().txId == txId &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if false;
        allow delete: if false;
      }

      // Subcollection 2: Real-Time DPS & Savings Goals (/users/{userId}/savingsGoals/{goalId})
      match /savingsGoals/{goalId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          existing().uid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isOwner(userId) &&
          existing().uid == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          isValidSavingsGoal(incoming()) &&
          incoming().goalId == goalId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          isValidSavingsGoal(incoming()) &&
          existing().status != 'completed' &&
          incoming().uid == existing().uid &&
          incoming().goalId == existing().goalId &&
          incoming().schemeType == existing().schemeType &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid &&
          (
            // Action 1: Deposit or Withdraw from Savings Goal
            incoming().diff(existing()).affectedKeys().hasOnly(['currentAmount', 'status', 'updatedAt']) ||
            // Action 2: Adjust Goal Target or Installment Plan
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'targetAmount', 'monthlyInstallment', 'updatedAt'])
          );

        allow delete: if false;
      }

      // Subcollection 3: Real-Time Push Notifications (/users/{userId}/notifications/{notifId})
      match /notifications/{notifId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(notifId) &&
          existing().uid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isOwner(userId) &&
          existing().uid == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(notifId) &&
          isValidNotificationItem(incoming()) &&
          incoming().notifId == notifId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(notifId) &&
          isValidNotificationItem(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().notifId == existing().notifId &&
          incoming().title == existing().title &&
          incoming().body == existing().body &&
          incoming().category == existing().category &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);

        allow delete: if false;
      }
    }
  }
}
